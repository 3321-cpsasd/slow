  "concepts": [
    {
      "key": "recursion",
      "revision": 1,
      "label": "递归",
      "definition": "递归把问题归约为结构相同但更简单的子问题；有效递归必须有无需继续递归的基本情形，并让每次递归调用在某种度量上更接近该基本情形。",
      "scope": {
        "course": "04831750 程序设计实习",
        "pilotRole": "递归机制与终止条件"
      },
      "boundaries": [
        "基本情形和参数推进只是通用结构，具体输入域上的终止性仍需单独证明。",
        "递归表达清晰不自动意味着运行效率优于迭代实现。"
      ],
      "objectiveKeys": [
        "solve_with_enumeration_recursion_and_search",
        "model_and_solve_with_dynamic_programming"
      ],
      "claimKeys": [
        "recursion_reduces_same_structure",
        "recursion_requires_base_and_progress"
      ]
    },
    {
      "key": "graph_search",
      "revision": 1,
      "label": "深度优先与广度优先搜索",
      "definition": "图遍历从一个起点按确定的组织方式访问可达顶点；DFS 递归或用栈深入未访问邻接点，BFS 用队列逐层扩展，访问标记用于避免环造成重复访问。",
      "scope": {
        "course": "04831750 程序设计实习",
        "pilotRole": "DFS/BFS 遍历机制"
      },
      "boundaries": [
        "从单一起点不保证访问非连通图中的全部顶点。",
        "复杂度结论依赖图表示、邻接访问成本以及每个顶点和边的处理次数。",
        "通用遍历机制不证明具体剪枝条件或回溯状态恢复的正确性。"
      ],
      "objectiveKeys": [
        "solve_with_enumeration_recursion_and_search"
      ],
      "claimKeys": [
        "graph_visited_prevents_cycle_revisit",
        "dfs_recursively_visits_unvisited_neighbors",
        "bfs_uses_queue_for_level_frontier",
        "dfs_linear_graph_work_under_model"
      ]
    },
    {
      "key": "dynamic_programming",
      "revision": 1,
      "label": "动态规划",
      "definition": "动态规划针对会重复求解相同子问题的递归结构，保存子问题结果以避免重复计算；可以用记忆化按需求值，也可以按依赖顺序制表求值。",
      "scope": {
        "course": "04831750 程序设计实习",
        "pilotRole": "从递归到记忆化与制表"
      },
      "boundaries": [
        "状态键必须包含决定子问题结果所需的全部信息。",
        "通用动态规划模式不证明具体状态转移或边界条件正确。",
        "制表顺序必须满足子问题依赖，空间压缩还需证明被覆盖状态不会再使用。"
      ],
      "objectiveKeys": [
        "model_and_solve_with_dynamic_programming"
      ],
      "claimKeys": [
        "dp_eliminates_repeated_subproblems",
        "dp_memoization_reuses_stored_result",
        "dp_tabulation_respects_dependencies"
      ]
    }
  ],
