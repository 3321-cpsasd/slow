# This file belongs on the ECS host at /opt/slow/.env.
# Never commit the real file or copy it into a browser bundle.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_PROVIDER_PROTOCOL=openai
OPENAI_API_MODE=responses
OPENAI_REASONING_MODE=optional
AI_FALLBACK_MODELS=qwen3.8-max-preview,kimi/kimi-k3
# Qwen 3.8 与 Kimi K3 可属于不同计费方案；仅在服务端填写各自的 Key 与 Base URL。
QWEN38_API_KEY=
QWEN38_BASE_URL=
KIMI_K3_API_KEY=
KIMI_K3_BASE_URL=

APP_MODE=production
AUTH_MODE=password
WEB_ORIGIN=https://learn.example.com
SESSION_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=86400
SESSION_COOKIE_SECURE=true
PASSWORD_ESCROW_ENABLED=false
REGISTRATION_MODE=closed
ALPHA_REGISTRATION_CODE=
ALPHA_REGISTRATION_DAILY_LIMIT=100

# PostgreSQL 仅在 Compose 内网中监听，不映射宿主机端口。密码需使用 URL-safe
# 随机字符，因为同一值也用于 API 的 SQLAlchemy 连接 URL。
POSTGRES_DB=slow
POSTGRES_USER=slow
POSTGRES_PASSWORD=

# AUTH_MODE=oidc 时才需要填写以下配置
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=统一身份账户
OIDC_REDIRECT_URI=https://learn.example.com/api/auth/callback
OIDC_SCOPES=openid email profile
