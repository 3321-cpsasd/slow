# This file belongs on the ECS host at /opt/slow/.env.
# Never commit the real file or copy it into a browser bundle.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_PROVIDER_PROTOCOL=openai
OPENAI_API_MODE=responses
OPENAI_REASONING_MODE=optional

APP_MODE=production
AUTH_MODE=oidc
WEB_ORIGIN=https://learn.example.com
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=统一身份账户
OIDC_REDIRECT_URI=https://learn.example.com/api/auth/callback
OIDC_SCOPES=openid email profile
