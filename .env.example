# 必填：仅保存在服务端，不会下发到浏览器
OPENAI_API_KEY=

# 默认兼顾质量与成本；也可以改为你账号可用的其他 Responses API 模型
OPENAI_MODEL=gpt-5
AI_PROVIDER_PROTOCOL=openai
OPENAI_API_MODE=responses
OPENAI_REASONING_MODE=optional

API_PORT=8000
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
DATA_PATH=./data/learning.db

# 本地默认启用五个开发验证账号；也可改为 demo 跳过登录页。
# 正式邀请制账号密码登录使用 APP_MODE=production + AUTH_MODE=password。
# local 与 demo 都禁止用于生产；需要外部身份服务时也可使用 oidc。
APP_MODE=development
AUTH_MODE=local
SESSION_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=86400
SESSION_COOKIE_SECURE=false

# 仅供上线前的管理员密码交接；会把明文写入权限为 0600 的独立文件。
# APP_MODE=production 会拒绝在此项为 true 时启动。默认必须保持关闭。
PASSWORD_ESCROW_ENABLED=false

# AUTH_MODE=oidc 时必填
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=统一身份账户
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
OIDC_SCOPES=openid email profile
